# ===================================================================
# SIRAGU AI (சிறகு AI) - Environment Variables Configuration
# ===================================================================

# GEMINI_API_KEY: Required for server-side Gemini AI conversations and TTS.
# Obtain a key from https://aistudio.google.com/
# On Vercel: Add this under Project Settings -> Environment Variables.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# PORT: Local development and production listening port (Default: 3000)
PORT=3000

# NODE_ENV: 'development' or 'production'
NODE_ENV=development
